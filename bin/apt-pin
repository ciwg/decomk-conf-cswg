#!/usr/bin/env bash
set -euo pipefail

# Intent: Require the system APT configuration to name the current Ubuntu
# archive snapshot, then preserve normal apt-get command semantics for
# Dockerfile and later Makefile call sites. Source: DI-007-20260513-195450

usage() {
  cat <<'USAGE'
Usage:
  apt-pin <apt-get command> [apt-get args...]

Required environment:
  none

Examples:
  printf 'APT::Snapshot "%s";\n' "20260430T000000Z" > /etc/apt/apt.conf.d/50snapshot
  apt-pin update -qq
  apt-pin install -y vim=2:9.1.0016-1ubuntu7.12
USAGE
}

read_apt_snapshot() {
  local config_output snapshot

  if ! config_output="$(apt-config shell Snapshot APT::Snapshot)"; then
    echo "ERROR: unable to read APT::Snapshot from apt config" >&2
    exit 64
  fi

  if [[ -z "$config_output" ]]; then
    echo "ERROR: APT::Snapshot must be set in apt config, for example /etc/apt/apt.conf.d/50snapshot" >&2
    exit 64
  fi

  if [[ "$config_output" != Snapshot=\'*\' ]]; then
    echo "ERROR: unexpected apt-config output for APT::Snapshot: $config_output" >&2
    exit 64
  fi

  snapshot="${config_output#Snapshot=\'}"
  snapshot="${snapshot%\'}"
  printf '%s\n' "$snapshot"
}

validate_snapshot() {
  local snapshot="$1"

  if [[ ! "$snapshot" =~ ^[0-9]{8}T[0-9]{6}Z$ ]]; then
    echo "ERROR: APT::Snapshot has invalid format: $snapshot" >&2
    echo "Expected format: YYYYMMDDTHHMMSSZ" >&2
    exit 64
  fi
}

main() {
  local snapshot

  if [[ $# -eq 0 ]]; then
    usage >&2
    exit 64
  fi

  snapshot="$(read_apt_snapshot)"
  validate_snapshot "$snapshot"

  exec apt-get "$@"
}

main "$@"
