// GUI runtime selftest devcontainer.
// Intent: Select GUI-SELFTEST-1 only for explicit GUI selftest runs while keeping
// the normal producer devcontainer on its existing decomk-conf-cswg context.
// Source: DI-tazit (TODO-tozoh)
// Intent: Use the hyphenated GUI selftest context name selected by the
// repo-wide pre-Block20 naming cleanup.
// Source: DI-ruvop (TODO-fogus)
{
  "name": "decomk-conf-cswg-gui-selftest",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": "../.."
  },
  // Intent: Honor the image entrypoint so published producer images can carry
  // the long-lived runit supervisor contract into consumer repos.
  // Source: DI-fiduv (TODO-fogup)
  "overrideCommand": false,
  "containerEnv": {
    "DECOMK_CONF_URI": "git:https://github.com/ciwg/decomk-conf-cswg.git?ref=main",
    "DECOMK_CONTEXT": "GUI-SELFTEST-1",
    "DECOMK_FAIL_NOBOOT": "false",
    "DECOMK_TOOL_URI": "go:github.com/stevegt/decomk/cmd/decomk@main"
  },
  "updateRemoteUserUID": false,
  "updateContentCommand": "bash .devcontainer/decomk-stage0.sh updateContent",
  "postCreateCommand": "bash .devcontainer/decomk-stage0.sh postCreate"
}
